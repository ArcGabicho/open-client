# Ignorar dependencias y binarios de compilación
**/bin/
**/obj/
**/out/

# Ignorar secretos locales (.env nunca debe entrar al contexto de build)
.env
.env.*
!.env.example

# Ignorar control de versiones y documentación
.git/
.gitignore
.vscode/
.idea/
docs/
README.md
LICENSE.md

# Ignorar base de datos y logs locales
**/*.db
**/*.db-shm
**/*.db-wal
**/*.log

# Ignorar scripts locales
scripts/