# ---------------------------------------------------
# FASE 1: Base de Ejecución (Runtime de Producción)
# ---------------------------------------------------
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS base
WORKDIR /app
EXPOSE 8080
EXPOSE 8081

# ---------------------------------------------------
# FASE 2: Entorno de Desarrollo (con SDK y Hot Reload)
# ---------------------------------------------------
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS development
WORKDIR /src

# Configurar variables para desarrollo en Docker
ENV DOTNET_USE_POLLING_FILE_WATCHER=1
ENV ASPNETCORE_ENVIRONMENT=Development

# Copiar csproj y restaurar dependencias primero (cache)
COPY ["open-client.csproj", "./"]
RUN dotnet restore "open-client.csproj"

# Copiar el código fuente completo
COPY . .

EXPOSE 8080
# Comando para monitorear cambios y recompilar automáticamente
CMD ["dotnet", "watch", "run", "--urls", "http://+:8080"]

# ---------------------------------------------------
# FASE 3: Compilado para Producción
# ---------------------------------------------------
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY ["open-client.csproj", "./"]
RUN dotnet restore "open-client.csproj"

COPY . .
RUN dotnet build "open-client.csproj" -c Release -o /app/build

# ---------------------------------------------------
# FASE 4: Publicación de Binarios
# ---------------------------------------------------
FROM build AS publish
RUN dotnet publish "open-client.csproj" -c Release -o /app/publish /p:UseAppHost=false

# ---------------------------------------------------
# FASE 5: Imagen Final de Producción (Limpia y Ligera)
# ---------------------------------------------------
FROM base AS final
WORKDIR /app
COPY --from=publish /app/publish .
ENTRYPOINT ["dotnet", "open-client.dll"]