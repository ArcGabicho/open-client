@page "/dashboard/clients"
@layout DashboardLayout
@attribute [Authorize]
@rendermode InteractiveServer
@implements IDisposable

@using OpenClient.Interfaces
@using OpenClient.Models.DTO
@inject IClientService ClientService

<PageTitle>Open Client | Panel de Clientes</PageTitle>

<div class="clients">

    <header class="clients-head">
        <div class="clients-head-titles">
            <h1 class="clients-title">Clientes</h1>
            <p class="clients-count">@CountLabel</p>
        </div>

        <button type="button" class="btn-add">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 5v14M5 12h14" />
            </svg>
            Nuevo cliente
        </button>
    </header>

    <div class="clients-controls">
        <div class="clients-filters">
            <label class="search-field">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="11" cy="11" r="7" />
                    <path d="M21 21l-4.3-4.3" />
                </svg>
                <input type="search" value="@filter.Search" @oninput="OnSearchInput"
                       placeholder="Buscar empresa, contacto, RUC o correo…" aria-label="Buscar clientes" />
                @if (loading)
                {
                    <span class="spinner" aria-hidden="true"></span>
                }
            </label>

            <span class="pill-select">
                <select @bind="filter.SortBy" @bind:after="ApplyFilterAsync" aria-label="Ordenar">
                    <option value="recent">Recientes</option>
                    <option value="name">Nombre A–Z</option>
                    <option value="oldest">Antigüedad</option>
                </select>
            </span>

            <span class="pill-select">
                <select @bind="filter.Industry" @bind:after="ApplyFilterAsync" aria-label="Filtrar por industria">
                    <option value="">Industria</option>
                    @foreach (var industry in industries)
                    {
                        <option value="@industry">@industry</option>
                    }
                </select>
            </span>
        </div>

        <div class="view-toggle" role="group" aria-label="Cambiar vista">
            <button type="button" class='view-btn @(viewMode == "list" ? "is-active" : null)'
                    @onclick='() => viewMode = "list"' aria-pressed="@(viewMode == "list")" aria-label="Vista de lista">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M8 6h13M8 12h13M8 18h13M3.5 6h.01M3.5 12h.01M3.5 18h.01" />
                </svg>
            </button>
            <button type="button" class='view-btn @(viewMode == "grid" ? "is-active" : null)'
                    @onclick='() => viewMode = "grid"' aria-pressed="@(viewMode == "grid")" aria-label="Vista de cuadrícula">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="4" y="4" width="7" height="7" rx="1.5" />
                    <rect x="13" y="4" width="7" height="7" rx="1.5" />
                    <rect x="4" y="13" width="7" height="7" rx="1.5" />
                    <rect x="13" y="13" width="7" height="7" rx="1.5" />
                </svg>
            </button>
        </div>
    </div>

    <section class="clients-card @(loading ? "is-loading" : null)" aria-busy="@loading">

        @if (viewMode == "list")
        {
            <div class="acc">
                <div class="acc-head" aria-hidden="true">
                    <span>Cliente</span>
                    <span>Contacto</span>
                    <span>Cargo</span>
                    <span>Alta</span>
                    <span class="acc-col-caret"></span>
                </div>

                @if (result is null)
                {
                    <div class="table-note">Cargando clientes…</div>
                }
                else if (result.Items.Count == 0)
                {
                    <div class="empty-state">
                        <strong>Sin resultados</strong>
                        <span>Ajusta la búsqueda o los filtros para ver más clientes.</span>
                    </div>
                }
                else
                {
                    @foreach (var c in result.Items)
                    {
                        var isOpen = expandedId == c.Id;

                        <div class="acc-item @(isOpen ? "is-open" : null)" @key="c.Id">
                            <button type="button" class="acc-summary" @onclick="() => Toggle(c.Id)"
                                    aria-expanded="@isOpen" aria-controls="@($"acc-panel-{c.Id}")">
                                <span class="acc-cell acc-cell-client">
                                    <span class="client-avatar" style="background:@AvatarColor(c.DisplayName)" aria-hidden="true">@c.Initials</span>
                                    <span class="client-name">@c.DisplayName</span>
                                </span>
                                <span class="acc-cell cell-soft" data-label="Contacto">@Dash(c.ContactName)</span>
                                <span class="acc-cell cell-soft" data-label="Cargo">@Dash(c.JobTitle)</span>
                                <span class="acc-cell cell-date" data-label="Alta">@c.CreatedAt.ToString("dd/MM/yyyy")</span>
                                <span class="acc-caret" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6" /></svg>
                                </span>
                            </button>

                            @if (isOpen)
                            {
                                <div class="acc-panel" id="@($"acc-panel-{c.Id}")">
                                    <div class="acc-panel-inner">
                                        <dl class="acc-fields">
                                            <div class="acc-field acc-field-wide">
                                                <dt>Razón social</dt>
                                                <dd>@Dash(c.LegalName)</dd>
                                            </div>

                                            <div class="acc-field">
                                                <dt>RUC</dt>
                                                <dd class="acc-mono">@Dash(c.TaxId)</dd>
                                            </div>

                                            <div class="acc-field">
                                                <dt>Industria</dt>
                                                <dd>
                                                    @if (!string.IsNullOrWhiteSpace(c.Industry))
                                                    {
                                                        <span class="chip @ChipClass(c.Industry)">@c.Industry</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="chip chip-muted">Sin industria</span>
                                                    }
                                                </dd>
                                            </div>

                                            <div class="acc-field">
                                                <dt>Correo</dt>
                                                <dd>
                                                    @if (!string.IsNullOrWhiteSpace(c.Email))
                                                    {
                                                        <a class="acc-link" href="mailto:@c.Email">
                                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg>
                                                            <span>@c.Email</span>
                                                        </a>
                                                    }
                                                    else
                                                    {
                                                        <span class="acc-empty">Sin correo</span>
                                                    }
                                                </dd>
                                            </div>

                                            <div class="acc-field">
                                                <dt>Teléfono</dt>
                                                <dd>
                                                    @if (!string.IsNullOrWhiteSpace(c.PhoneNumber))
                                                    {
                                                        <a class="acc-link" href="@TelHref(c.PhoneNumber)">
                                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15.5 21a2 2 0 0 0 2-2.2l-.4-2.6a2 2 0 0 0-1.4-1.6l-2.3-.7a2 2 0 0 0-2.1.6l-.6.7a12 12 0 0 1-4.9-4.9l.7-.6a2 2 0 0 0 .6-2.1l-.7-2.3A2 2 0 0 0 6.8 2.9L4.2 2.5A2 2 0 0 0 2 4.5 17 17 0 0 0 15.5 21Z" /></svg>
                                                            <span>@c.PhoneNumber</span>
                                                        </a>
                                                    }
                                                    else
                                                    {
                                                        <span class="acc-empty">Sin teléfono</span>
                                                    }
                                                </dd>
                                            </div>

                                            <div class="acc-field">
                                                <dt>Sitio web</dt>
                                                <dd>
                                                    @if (!string.IsNullOrWhiteSpace(c.Website))
                                                    {
                                                        <a class="acc-link" href="@c.Website" target="_blank" rel="noopener noreferrer">
                                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M3.5 9h17M3.5 15h17M12 3a13 13 0 0 0 0 18M12 3a13 13 0 0 1 0 18" /></svg>
                                                            <span>@WebDisplay(c.Website)</span>
                                                        </a>
                                                    }
                                                    else
                                                    {
                                                        <span class="acc-empty">Sin sitio web</span>
                                                    }
                                                </dd>
                                            </div>

                                            <div class="acc-field">
                                                <dt>Ubicación</dt>
                                                <dd>@(string.IsNullOrWhiteSpace(c.Location) ? "—" : c.Location)</dd>
                                            </div>

                                            <div class="acc-field acc-field-wide">
                                                <dt>Dirección</dt>
                                                <dd>@Dash(c.Address)</dd>
                                            </div>
                                        </dl>

                                        <div class="acc-panel-actions">
                                            <button type="button" class="acc-act acc-act-primary">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9zM14 3v6h6M8 13h8M8 17h5" /></svg>
                                                Ver ficha
                                            </button>
                                            <button type="button" class="acc-act">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5h16M4 12h16M4 19h10" /></svg>
                                                Notas
                                            </button>
                                            <button type="button" class="acc-act">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20h4l10.5-10.5a2.1 2.1 0 0 0-3-3L5 17v3z" /></svg>
                                                Editar
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                }
            </div>
        }
        else
        {
            <div class="client-grid">
                @if (result is null)
                {
                    <div class="table-note">Cargando clientes…</div>
                }
                else if (result.Items.Count == 0)
                {
                    <div class="empty-state">
                        <strong>Sin resultados</strong>
                        <span>Ajusta la búsqueda o los filtros para ver más clientes.</span>
                    </div>
                }
                else
                {
                    @foreach (var c in result.Items)
                    {
                        <article class="client-card" @key="c.Id">
                            <header class="client-card-head">
                                <span class="client-avatar" style="background:@AvatarColor(c.DisplayName)" aria-hidden="true">@c.Initials</span>
                                <div class="client-card-id">
                                    <span class="client-name">@c.DisplayName</span>
                                    <span class="cell-soft">@Dash(c.ContactName)</span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(c.Industry))
                                {
                                    <span class="chip @ChipClass(c.Industry)">@c.Industry</span>
                                }
                            </header>
                            <dl class="client-card-meta">
                                <div><dt>Cargo</dt><dd>@Dash(c.JobTitle)</dd></div>
                                <div><dt>Correo</dt><dd>@Dash(c.Email)</dd></div>
                                <div><dt>Teléfono</dt><dd>@Dash(c.PhoneNumber)</dd></div>
                                <div><dt>Alta</dt><dd>@c.CreatedAt.ToString("dd/MM/yyyy")</dd></div>
                            </dl>
                            <div class="row-actions">
                                <button type="button" class="chip-btn chip-btn-notes">Notas</button>
                                <button type="button" class="chip-btn chip-btn-view">Ver</button>
                            </div>
                        </article>
                    }
                }
            </div>
        }

        <footer class="clients-pager">
            <span class="pager-note">10 por página</span>

            <nav class="pager-nums" aria-label="Paginación">
                <button type="button" class="pager-btn pager-arrow" disabled="@(!(result?.HasPrevious ?? false))"
                        @onclick="() => GoTo(filter.Page - 1)" aria-label="Anterior">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6" /></svg>
                </button>

                @foreach (var p in PageItems())
                {
                    @if (p is null)
                    {
                        <span class="pager-gap">…</span>
                    }
                    else
                    {
                        <button type="button" class="pager-btn @(p == filter.Page ? "is-active" : null)" @onclick="() => GoTo(p.Value)">@p</button>
                    }
                }

                <button type="button" class="pager-btn pager-arrow" disabled="@(!(result?.HasNext ?? false))"
                        @onclick="() => GoTo(filter.Page + 1)" aria-label="Siguiente">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
                </button>
            </nav>

            <span class="pager-legend">
                @(result?.FirstItemIndex ?? 0) - @(result?.LastItemIndex ?? 0) de @((result?.TotalCount ?? 0).ToString("N0")) resultados
            </span>
        </footer>

    </section>

</div>

@code {
    private readonly ClientSearchFilter filter = new() { PageSize = 10 };

    private PagedResult<ClientListItemDto>? result;
    private IReadOnlyList<string> industries = [];
    private string viewMode = "list";
    private bool loading;
    private int? expandedId;

    private CancellationTokenSource? searchDebounce;

    private void Toggle(int id) =>
        expandedId = expandedId == id ? null : id;

    protected override async Task OnInitializedAsync()
    {
        industries = await ClientService.GetIndustriesAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        expandedId = null;
        StateHasChanged();

        try
        {
            result = await ClientService.GetClientsAsync(filter);
        }
        finally
        {
            loading = false;
        }
    }

    private async Task ApplyFilterAsync()
    {
        filter.Page = 1;
        await LoadAsync();
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        filter.Search = e.Value?.ToString();
        filter.Page = 1;

        searchDebounce?.Cancel();
        searchDebounce?.Dispose();
        searchDebounce = new CancellationTokenSource();
        var token = searchDebounce.Token;

        try
        {
            await Task.Delay(350, token);
            await LoadAsync();
        }
        catch (TaskCanceledException)
        {
            // Nueva pulsación antes de que expire el retardo: se ignora.
        }
    }

    private async Task GoTo(int page)
    {
        var totalPages = Math.Max(result?.TotalPages ?? 1, 1);
        var target = Math.Clamp(page, 1, totalPages);

        if (target == filter.Page)
        {
            return;
        }

        filter.Page = target;
        await LoadAsync();
    }

    private IEnumerable<int?> PageItems()
    {
        var total = result?.TotalPages ?? 0;
        var current = filter.Page;
        var items = new List<int?>();

        if (total <= 7)
        {
            for (var i = 1; i <= total; i++)
            {
                items.Add(i);
            }

            return items;
        }

        items.Add(1);

        if (current > 4)
        {
            items.Add(null);
        }

        var start = Math.Max(2, current - 1);
        var end = Math.Min(total - 1, current + 1);

        for (var i = start; i <= end; i++)
        {
            items.Add(i);
        }

        if (current < total - 3)
        {
            items.Add(null);
        }

        items.Add(total);
        return items;
    }

    private string CountLabel =>
        result is null
            ? "Cargando…"
            : $"{result.TotalCount:N0} clientes en total";

    private static string Dash(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "—" : value;

    private static string WebDisplay(string url) =>
        url.Replace("https://", "", StringComparison.OrdinalIgnoreCase)
           .Replace("http://", "", StringComparison.OrdinalIgnoreCase)
           .TrimEnd('/');

    private static string TelHref(string phone) =>
        "tel:" + new string(phone.Where(ch => char.IsDigit(ch) || ch == '+').ToArray());

    private static readonly string[] ChipVariants =
        { "chip-a", "chip-b", "chip-c", "chip-d", "chip-e", "chip-f" };

    private static string ChipClass(string? seed)
    {
        if (string.IsNullOrEmpty(seed))
        {
            return "chip-muted";
        }

        var sum = 0;

        foreach (var ch in seed)
        {
            sum += ch;
        }

        return ChipVariants[sum % ChipVariants.Length];
    }

    private static readonly string[] AvatarPalette =
        { "#635bff", "#1f9d6b", "#e0893b", "#2f6df0", "#c0497a", "#7c5cff" };

    private static string AvatarColor(string seed)
    {
        if (string.IsNullOrEmpty(seed))
        {
            return "#8b909c";
        }

        var sum = 0;

        foreach (var ch in seed)
        {
            sum += ch;
        }

        return AvatarPalette[sum % AvatarPalette.Length];
    }

    public void Dispose()
    {
        searchDebounce?.Cancel();
        searchDebounce?.Dispose();
    }
}
