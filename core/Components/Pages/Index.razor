@page "/"
@layout MainLayout

<PageTitle>Open Client | Sistema de datos comerciales de clientes</PageTitle>

<div class="landing">

    <!-- ================= HERO ================= -->
    <section class="hero">
        <div class="hero-copy">
            <span class="eyebrow">
                <span class="eyebrow-dot"></span>
                Open source · Licencia MIT
            </span>

            <h1 class="hero-title">
                El sistema de datos comerciales de tus
                <span class="hero-accent">clientes</span>, en tu propia infraestructura.
            </h1>

            <p class="hero-lead">
                Open Client es un panel web para consultar y gestionar tu cartera comercial de
                clientes. Despliégalo en minutos y conserva el control total sobre la
                información, con Blazor Web App, Docker y Azure.
            </p>

            <div class="hero-actions">
                <a href="/log-in" class="btn btn-primary">
                    Iniciar sesión
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M5 12h14M13 6l6 6-6 6" />
                    </svg>
                </a>
                <a href="/docs" class="btn btn-ghost">Ver documentación</a>
            </div>

            <p class="hero-note">
                ¿Solo mirando? <a href="http://openclient.azure.app" target="_blank" rel="noopener noreferrer">Abre el demo en vivo</a>.
            </p>
        </div>

        <div class="hero-visual" aria-hidden="true">
            <div class="mock mock-panel">
                <div class="mock-panel-head">
                    <span class="mock-title">Clientes</span>
                    <span class="mock-search">Buscar cliente…</span>
                </div>
                <ul class="mock-rows">
                    <li>
                        <span class="mock-avatar mock-a1">NR</span>
                        <span class="mock-name">Nova Retail S.A.</span>
                        <span class="mock-chip mock-chip-ok">Retail</span>
                        <span class="mock-val">20342…108</span>
                    </li>
                    <li>
                        <span class="mock-avatar mock-a2">CL</span>
                        <span class="mock-name">Comercial Lima</span>
                        <span class="mock-chip mock-chip-ok">Servicios</span>
                        <span class="mock-val">20510…203</span>
                    </li>
                    <li>
                        <span class="mock-avatar mock-a3">AG</span>
                        <span class="mock-name">Andes Group</span>
                        <span class="mock-chip mock-chip-mute">Sin industria</span>
                        <span class="mock-val">20554…771</span>
                    </li>
                    <li>
                        <span class="mock-avatar mock-a4">VP</span>
                        <span class="mock-name">Volt Partners</span>
                        <span class="mock-chip mock-chip-ok">Tecnología</span>
                        <span class="mock-val">20600…912</span>
                    </li>
                </ul>
            </div>

            <div class="mock mock-mini">
                <div class="mock-mini-head">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                        <path d="M4 7h16M9 7V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2M6 7l1 13a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2l1-13" />
                    </svg>
                    Alta, edición y borrado
                </div>
                <p>Formulario con validación y borrado lógico reversible.</p>
            </div>
        </div>
    </section>

    <!-- ================= STACK STRIP ================= -->
    <section class="stack" aria-label="Tecnologías">
        <span class="stack-label">Construido con</span>
        <ul class="stack-list">
            <li>.NET&nbsp;10</li>
            <li>Blazor Interactive Server</li>
            <li>EF&nbsp;Core&nbsp;10</li>
            <li>SQL&nbsp;Server&nbsp;2022</li>
            <li>Docker</li>
            <li>Azure Container Apps</li>
        </ul>
    </section>

    <!-- ================= FEATURES ================= -->
    <section class="section">
        <header class="section-head">
            <span class="eyebrow"><span class="eyebrow-dot"></span> Qué incluye</span>
            <h2 class="section-title">Un panel para operar tu cartera de clientes.</h2>
            <p class="section-lead">
                Un sitio público, el inicio de sesión y el panel de clientes. Nada de
                servicios externos: todo corre donde tú lo despliegues.
            </p>
        </header>

        <div class="feature-grid">
            <article class="feature-card">
                <span class="feature-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                        <path d="M16 19c0-2.2-1.8-4-4-4s-4 1.8-4 4M12 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z" />
                        <path d="M20 19c0-1.6-1-3-2.5-3.6M17 10.8A3 3 0 0 0 17 5" />
                    </svg>
                </span>
                <h3>Panel de clientes</h3>
                <p>Consulta y gestión de toda tu cartera comercial desde una interfaz única.</p>
            </article>

            <article class="feature-card">
                <span class="feature-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                        <circle cx="11" cy="11" r="7" />
                        <path d="M21 21l-4.3-4.3" />
                    </svg>
                </span>
                <h3>Búsqueda y filtros</h3>
                <p>Busca por razón social, RUC, contacto o correo; filtra por industria y ordena.</p>
            </article>

            <article class="feature-card">
                <span class="feature-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                        <path d="M12 5v14M5 12h14" />
                    </svg>
                </span>
                <h3>Alta, edición y borrado</h3>
                <p>Formulario con validación en servidor y borrado lógico reversible.</p>
            </article>

            <article class="feature-card">
                <span class="feature-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                        <path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9zM14 3v6h6M8 13h8M8 17h5" />
                    </svg>
                </span>
                <h3>Ficha completa</h3>
                <p>Cada cliente se despliega con todos sus datos: fiscales, contacto y ubicación.</p>
            </article>

            <article class="feature-card">
                <span class="feature-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                        <rect x="3" y="4" width="18" height="7" rx="2" />
                        <rect x="3" y="13" width="18" height="7" rx="2" />
                        <path d="M7 7.5h.01M7 16.5h.01" />
                    </svg>
                </span>
                <h3>Infraestructura propia</h3>
                <p>Imagen Docker multi-stage lista para Azure Container Apps o tu propia VM.</p>
            </article>

            <article class="feature-card">
                <span class="feature-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                        <rect x="4" y="10" width="16" height="11" rx="2" />
                        <path d="M8 10V7a4 4 0 0 1 8 0v3M12 15v2" />
                    </svg>
                </span>
                <h3>Acceso protegido</h3>
                <p>Autenticación por sesión: el panel solo es visible para usuarios con credenciales.</p>
            </article>
        </div>
    </section>

    <!-- ================= DEPLOY ================= -->
    <section class="section">
        <header class="section-head">
            <span class="eyebrow"><span class="eyebrow-dot"></span> Despliegue</span>
            <h2 class="section-title">Dos comandos y el panel está en marcha.</h2>
            <p class="section-lead">
                Instálalo en tu máquina para probarlo o despliégalo en tu infraestructura.
                Los datos se quedan siempre en tu SQL Server.
            </p>
        </header>

        <div class="deploy-cards">
            <div class="code-card">
                <div class="code-card-head">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                        <path d="M4 5h16v14H4zM7 9l3 3-3 3M13 15h4" />
                    </svg>
                    Instalación local
                </div>
                <pre class="code-block"><span class="code-prompt">$</span> curl -sSL https://raw.githubusercontent.com/ArcGabicho/open-client/master/scripts/setup.sh | bash</pre>
                <p class="code-foot">Necesario tener Bash y Docker.</p>
            </div>

            <div class="code-card">
                <div class="code-card-head">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                        <path d="M12 3l8 4.5v9L12 21l-8-4.5v-9zM4 7.5l8 4.5 8-4.5M12 21v-9" />
                    </svg>
                    Despliegue
                </div>
                <pre class="code-block"><span class="code-prompt">$</span> curl -sSL https://raw.githubusercontent.com/ArcGabicho/open-client/master/scripts/deploy.sh | bash</pre>
                <p class="code-foot">Compatible con Azure Container Apps y Azure VM.</p>
            </div>
        </div>
    </section>

    <!-- ================= FINAL CTA ================= -->
    <section class="cta-panel">
        <div class="cta-panel-copy">
            <h2>Despliega Open Client en tu propia infraestructura.</h2>
            <p>Clona el repositorio, ejecuta un script y ten tu panel comercial funcionando.</p>
        </div>
        <div class="cta-panel-actions">
            <a href="/log-in" class="btn btn-primary">Iniciar sesión</a>
            <a href="https://github.com/ArcGabicho/open-client" target="_blank" rel="noopener noreferrer" class="btn btn-ghost">
                Ver en GitHub
            </a>
        </div>
    </section>

</div>
