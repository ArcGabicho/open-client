@page "/log-in"
@layout LoginLayout
@using OpenClient.Models.DTO
@using Microsoft.JSInterop
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Iniciar Sesión - Open Client</PageTitle>

<div class="login-header">
    <h1 class="title">Ingresar</h1>

    <p class="subtitle">
        Ingresa tus credenciales super secretas.
    </p>
</div>

<EditForm Model="_model" OnValidSubmit="HandleLogin">
    <DataAnnotationsValidator />

    <div class="login-form">

        <div class="form-group">
            <label for="email">Correo</label>

            <InputText
                id="email"
                @bind-Value="_model.Email"
                type="email"
                placeholder="Ingresa tu correo"
                autocomplete="email" />

            <ValidationMessage For="@(() => _model.Email)" />
        </div>

        <div class="form-group">
            <label for="password">Contraseña</label>

            <InputText
                id="password"
                @bind-Value="_model.Password"
                type="password"
                placeholder="••••••••"
                autocomplete="current-password" />

            <ValidationMessage For="@(() => _model.Password)" />
        </div>

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="login-error">
                @_errorMessage
            </div>
        }

        <button
            type="submit"
            class="btn-submit"
            disabled="@_isLoading">

            @if (_isLoading)
            {
                <span>Ingresando...</span>
            }
            else
            {
                <span>Ingresar</span>
            }

        </button>

    </div>
</EditForm>

<p class="signup-prompt">
    ¿No querías llegar aquí?
    <a href="/">Volver</a>
</p>

@code {
    private readonly LoginModel _model = new();

    private bool _isLoading;

    private string? _errorMessage;

    private async Task HandleLogin()
    {
        _errorMessage = null;
        _isLoading = true;

        try
        {
            var status = await JS.InvokeAsync<int>(
                "openClientAuth.login",
                _model.Email,
                _model.Password);

            if (status is >= 200 and < 300)
            {
                Navigation.NavigateTo("/dashboard");
                return;
            }

            if (status == 401)
            {
                _errorMessage =
                    "Correo o contraseña incorrectos.";

                return;
            }

            _errorMessage =
                "No fue posible iniciar sesión.";
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(ex);

            _errorMessage =
                $"Error: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }
}