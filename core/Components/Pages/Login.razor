@page "/log-in"
@layout LoginLayout

<PageTitle>Iniciar Sesión - Open Client</PageTitle>

<div class="login-header">
    <h1 class="title">Ingresar</h1>

    <p class="subtitle">
        Ingresa tus credenciales super secretas.
    </p>
</div>

<form
    method="post"
    action="/auth/log-in"
    data-enhance="false">

    <AntiforgeryToken />

    <input
        type="hidden"
        name="returnUrl"
        value="@ReturnUrl" />

    <div class="login-form">

        <div class="form-group">
            <label for="email">Correo</label>

            <input
                id="email"
                name="Email"
                type="email"
                required
                maxlength="256"
                placeholder="Ingresa tu correo"
                autocomplete="email" />
        </div>

        <div class="form-group">
            <label for="password">Contraseña</label>

            <input
                id="password"
                name="Password"
                type="password"
                required
                placeholder="••••••••"
                autocomplete="current-password" />
        </div>

        @if (!string.IsNullOrWhiteSpace(ErrorText))
        {
            <div class="login-error">
                @ErrorText
            </div>
        }

        <button
            type="submit"
            class="btn-submit">

            <span>Ingresar</span>

        </button>

    </div>

</form>

<p class="signup-prompt">
    ¿No querías llegar aquí?
    <a href="/">Volver</a>
</p>

@code {
    // Códigos de error fijos (nunca texto libre del query string).
    private string ErrorText => ErrorCode switch
    {
        "invalid_credentials" => "Correo o contraseña incorrectos.",
        "invalid_input" => "Revisa los datos ingresados.",
        "form_expired" => "El formulario expiró. Recarga la página e inténtalo de nuevo.",
        _ => string.Empty
    };

    [SupplyParameterFromQuery(Name = "error")]
    public string? ErrorCode { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }
}
