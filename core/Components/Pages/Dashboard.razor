@page "/dashboard"
@layout DashboardLayout
@attribute [Authorize]

<PageTitle>Open Client | Inicio</PageTitle>

<div class="home">

    <header class="home-hero">
        <span class="home-eyebrow">Inicio</span>
        <h1 class="home-title">Bienvenido a Open&nbsp;Client</h1>
        <p class="home-lead">
            Este es tu panel. Desde aquí gestionas la cartera comercial de clientes:
            búsqueda, filtros, ficha completa y alta, edición o borrado.
        </p>
    </header>

    <nav class="home-modules" aria-label="Módulos">
        <a href="/dashboard/clients" class="home-card">
            <span class="home-card-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M16 19c0-2.2-1.8-4-4-4s-4 1.8-4 4M12 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z" />
                    <path d="M20 19c0-1.6-1-3-2.5-3.6M17 10.8A3 3 0 0 0 17 5" />
                </svg>
            </span>
            <span class="home-card-body">
                <strong>Clientes</strong>
                <span>Consulta y gestiona toda la cartera comercial.</span>
            </span>
            <svg class="home-card-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M9 6l6 6-6 6" />
            </svg>
        </a>

        <a href="/docs" target="_blank" rel="noopener noreferrer" class="home-card">
            <span class="home-card-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9zM14 3v6h6M8 13h8M8 17h5" />
                </svg>
            </span>
            <span class="home-card-body">
                <strong>Documentación</strong>
                <span>Instalación, despliegue y funcionamiento del panel.</span>
            </span>
            <svg class="home-card-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M7 17 17 7M9 7h8v8" />
            </svg>
        </a>
    </nav>

</div>
