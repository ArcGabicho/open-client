@page "/dashboard"
@layout DashboardLayout
@attribute [Authorize]
@rendermode InteractiveServer

@using OpenClient.Interfaces
@using OpenClient.Models.DTO
@inject IClientService ClientService

<PageTitle>Open Client | Inicio</PageTitle>

<div class="welcome">

    <header class="wl-hero">
        <div class="wl-hero-text">
            <span class="wl-eyebrow">@Today</span>
            <h1 class="wl-title">@greeting, bienvenido a Open&nbsp;Client.</h1>
            <p class="wl-lead">
                Tu panel de control: gestiona la cartera comercial, consulta los datos por API
                y trabaja con el agente de IA.
            </p>
        </div>
        <div class="wl-hero-actions">
            <a href="/dashboard/clients" class="wl-btn wl-btn-primary">Ver clientes</a>
            <a href="/docs" target="_blank" rel="noopener noreferrer" class="wl-btn wl-btn-ghost">Documentación</a>
        </div>
    </header>

    <section class="wl-stats" aria-label="Resumen del sistema">
        <article class="wl-stat">
            <span class="wl-stat-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M16 19c0-2.2-1.8-4-4-4s-4 1.8-4 4M12 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z" />
                    <path d="M20 19c0-1.6-1-3-2.5-3.6M17 10.8A3 3 0 0 0 17 5" />
                </svg>
            </span>
            <span class="wl-stat-text">
                <span class="wl-stat-label">Clientes registrados</span>
                <span class="wl-stat-value">@(loading ? "…" : totalClients.ToString("N0"))</span>
            </span>
        </article>

        <article class="wl-stat">
            <span class="wl-stat-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 7l9-4 9 4-9 4-9-4ZM3 12l9 4 9-4M3 17l9 4 9-4" />
                </svg>
            </span>
            <span class="wl-stat-text">
                <span class="wl-stat-label">Industrias distintas</span>
                <span class="wl-stat-value">@(loading ? "…" : industryCount.ToString("N0"))</span>
            </span>
        </article>

        <article class="wl-stat">
            <span class="wl-stat-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="9" />
                    <path d="M12 7v5l3 2" />
                </svg>
            </span>
            <span class="wl-stat-text">
                <span class="wl-stat-label">Último registro</span>
                <span class="wl-stat-value">@(loading ? "…" : LastCreatedLabel)</span>
            </span>
        </article>
    </section>

    <div class="wl-body">

        <section class="wl-quick" aria-label="Accesos rápidos">
            <span class="wl-quick-head">Accesos rápidos</span>
            <nav class="wl-tiles">
                <a href="/dashboard/clients" class="wl-tile">
                    <span class="wl-tile-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M16 19c0-2.2-1.8-4-4-4s-4 1.8-4 4M12 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z" />
                            <path d="M20 19c0-1.6-1-3-2.5-3.6M17 10.8A3 3 0 0 0 17 5" />
                        </svg>
                    </span>
                    <strong class="wl-tile-title">Clientes</strong>
                    <span class="wl-tile-desc">Consulta, filtra y gestiona toda tu cartera comercial de clientes.</span>
                    <span class="wl-tile-meta">@(loading ? "…" : totalClients.ToString("N0")) registros</span>
                    <span class="wl-tile-cta">
                        Abrir módulo
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
                    </span>
                </a>

                <a href="/dashboard/ai-agent" class="wl-tile">
                    <span class="wl-tile-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 3l1.9 4.6L18.5 9l-4.6 1.9L12 15l-1.9-4.1L5.5 9l4.6-1.4L12 3Z" />
                        </svg>
                    </span>
                    <strong class="wl-tile-title">Agente IA</strong>
                    <span class="wl-tile-desc">Haz preguntas sobre tus datos comerciales en lenguaje natural.</span>
                    <span class="wl-tile-meta">Asistente conversacional</span>
                    <span class="wl-tile-cta">
                        Abrir módulo
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
                    </span>
                </a>

                <a href="/dashboard/api" class="wl-tile">
                    <span class="wl-tile-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M9 8l-4 4 4 4M15 8l4 4-4 4" />
                        </svg>
                    </span>
                    <strong class="wl-tile-title">API</strong>
                    <span class="wl-tile-desc">Integra la información con acceso programático mediante tokens.</span>
                    <span class="wl-tile-meta">REST · JSON</span>
                    <span class="wl-tile-cta">
                        Abrir módulo
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
                    </span>
                </a>

                <a href="/dashboard/tutorials" class="wl-tile">
                    <span class="wl-tile-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M5 4h11l3 3v13H5zM9 4v6l2-1.4L13 10V4" />
                        </svg>
                    </span>
                    <strong class="wl-tile-title">Tutoriales</strong>
                    <span class="wl-tile-desc">Guías paso a paso para poner en marcha cada parte del panel.</span>
                    <span class="wl-tile-meta">Documentación interna</span>
                    <span class="wl-tile-cta">
                        Abrir módulo
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
                    </span>
                </a>
            </nav>
        </section>

        <figure class="wl-media">
            <span class="wl-media-head">Introducción a Open Client</span>
            <div class="wl-media-frame">
                @*
                    Coloca aquí tu vídeo y elimina .wl-media-placeholder:
                    <video class="wl-media-video" src="/assets/intro.mp4"
                           poster="/assets/intro.jpg" controls playsinline preload="none"></video>
                *@
                <div class="wl-media-placeholder">
                    <span class="wl-media-play" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
                    </span>
                    <span>Aún no hay vídeo configurado</span>
                </div>
            </div>
        </figure>

    </div>

</div>

@code {
    private bool loading = true;
    private int totalClients;
    private int industryCount;
    private DateTime? lastCreated;

    private readonly string greeting = GreetingFor(DateTime.Now);

    private static readonly string[] Meses =
    {
        "enero", "febrero", "marzo", "abril", "mayo", "junio",
        "julio", "agosto", "septiembre", "octubre", "noviembre", "diciembre"
    };

    private string Today
    {
        get
        {
            var now = DateTime.Now;
            return $"{now.Day} de {Meses[now.Month - 1]} de {now.Year}";
        }
    }

    private string LastCreatedLabel =>
        lastCreated is { } date ? date.ToString("dd/MM/yyyy") : "—";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var recent = await ClientService.GetClientsAsync(
                new ClientSearchFilter { Page = 1, PageSize = 10, SortBy = "recent" });

            totalClients = recent.TotalCount;
            lastCreated = recent.Items.Count > 0 ? recent.Items[0].CreatedAt : null;

            var industries = await ClientService.GetIndustriesAsync();
            industryCount = industries.Count;
        }
        finally
        {
            loading = false;
        }
    }

    private static string GreetingFor(DateTime now) => now.Hour switch
    {
        >= 5 and < 12 => "Buenos días",
        >= 12 and < 20 => "Buenas tardes",
        _ => "Buenas noches"
    };
}
