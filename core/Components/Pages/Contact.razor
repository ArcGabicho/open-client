@page "/contact"
@rendermode InteractiveServer

@using OpenClient.Interfaces
@using OpenClient.Models.DTO
@inject IContactMailer Mailer

<PageTitle>Open Client | Contacto</PageTitle>

<HeadContent>
    <meta name="description" content="Ponte en contacto con el equipo de OpenClient para consultas comerciales, cotizaciones o alianzas." />
    <meta name="keywords" content="contacto, ventas, consultas, OpenClient, escribir" />

    <meta property="og:title" content="Open Client | Ponte en Contacto" />
    <meta property="og:description" content="Envíanos un mensaje y nos pondremos en contacto contigo a la brevedad." />
    <meta property="og:type" content="website" />
</HeadContent>

<div class="contact">

    <section class="contact-hero">
        <span class="eyebrow"><span class="eyebrow-dot"></span> Contacto</span>
        <h1 class="contact-title">Contáctanos</h1>
        <p class="contact-lead">
            ¿Tienes preguntas sobre Open Client, sus módulos o su despliegue? Escríbenos con el
            formulario y tu mensaje llegará a <strong>contact@gabicho.dev</strong>.
        </p>
    </section>

    <section class="contact-body">
        @if (state == SendState.Sent)
        {
            <div class="contact-form contact-done" role="status">
                <span class="contact-done-mark" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 6 9 17l-5-5" />
                    </svg>
                </span>
                <h2>Mensaje enviado</h2>
                <p>Gracias por escribir. Te responderemos a <strong>@model.Email</strong> a la brevedad.</p>
                <button type="button" class="btn btn-ghost" @onclick="Reset">Enviar otro mensaje</button>
            </div>
        }
        else
        {
            <form class="contact-form" aria-label="Formulario de contacto" @onsubmit="SubmitAsync" @onsubmit:preventDefault="true">

                @if (state == SendState.Error && banner is not null)
                {
                    <div class="contact-alert" role="alert">@banner</div>
                }

                @if (fieldErrors.Count > 0)
                {
                    <ul class="contact-errors">
                        @foreach (var e in fieldErrors) { <li>@e</li> }
                    </ul>
                }

                <div class="field-row">
                    <div class="field">
                        <label for="c-name">Nombre</label>
                        <input id="c-name" type="text" autocomplete="name" maxlength="120"
                               placeholder="Tu nombre" @bind="model.Name" @bind:event="oninput" />
                    </div>
                    <div class="field">
                        <label for="c-email">Correo</label>
                        <input id="c-email" type="email" autocomplete="email" maxlength="255"
                               placeholder="tucorreo@ejemplo.com" @bind="model.Email" @bind:event="oninput" />
                    </div>
                </div>

                <div class="field">
                    <label for="c-subject">Asunto</label>
                    <input id="c-subject" type="text" maxlength="150"
                           placeholder="¿En qué te podemos ayudar?" @bind="model.Subject" @bind:event="oninput" />
                </div>

                <div class="field">
                    <label for="c-message">Mensaje</label>
                    <textarea id="c-message" rows="6" maxlength="4000"
                              placeholder="Cuéntanos los detalles…" @bind="model.Body" @bind:event="oninput"></textarea>
                </div>

                <button type="submit" class="btn btn-primary contact-submit" disabled="@(state == SendState.Sending)">
                    @(state == SendState.Sending ? "Enviando…" : "Enviar mensaje")
                </button>
                <p class="contact-hint">
                    También puedes escribirnos abriendo una incidencia en
                    <a href="https://github.com/ArcGabicho/open-client/issues" target="_blank" rel="noopener noreferrer">GitHub</a>.
                </p>
            </form>
        }

        <aside class="contact-aside">
            <h2>Otras vías</h2>
            <ul class="contact-channels">
                <li>
                    <span class="channel-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                            <rect x="3" y="5" width="18" height="14" rx="2" />
                            <path d="m3 7 9 6 9-6" />
                        </svg>
                    </span>
                    <div>
                        <strong>Correo</strong>
                        <a href="mailto:contact@gabicho.dev">contact@gabicho.dev</a>
                    </div>
                </li>
                <li>
                    <span class="channel-icon">
                        <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                            <path fill-rule="evenodd" clip-rule="evenodd" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.4 7.4 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
                        </svg>
                    </span>
                    <div>
                        <strong>Repositorio</strong>
                        <a href="https://github.com/ArcGabicho/open-client" target="_blank" rel="noopener noreferrer">github.com/ArcGabicho/open-client</a>
                    </div>
                </li>
                <li>
                    <span class="channel-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                            <circle cx="12" cy="12" r="9" />
                            <path d="M12 8v5M12 16h.01" />
                        </svg>
                    </span>
                    <div>
                        <strong>Incidencias</strong>
                        <a href="https://github.com/ArcGabicho/open-client/issues" target="_blank" rel="noopener noreferrer">Reportar un problema o sugerencia</a>
                    </div>
                </li>
            </ul>
        </aside>
    </section>

</div>

@code {
    private enum SendState { Idle, Sending, Sent, Error }

    private readonly ContactMessage model = new();
    private SendState state = SendState.Idle;
    private string? banner;
    private readonly List<string> fieldErrors = [];

    private async Task SubmitAsync()
    {
        if (state == SendState.Sending)
        {
            return;
        }

        state = SendState.Sending;
        banner = null;
        fieldErrors.Clear();

        try
        {
            var result = await Mailer.SendAsync(model);

            switch (result.Status)
            {
                case ContactSendStatus.Sent:
                    state = SendState.Sent;
                    break;

                case ContactSendStatus.Invalid:
                    fieldErrors.AddRange(result.Errors);
                    state = SendState.Error;
                    break;

                case ContactSendStatus.NotConfigured:
                    banner = "El envío de correo no está configurado en este despliegue. " +
                             "Escríbenos a contact@gabicho.dev o abre una incidencia en GitHub.";
                    state = SendState.Error;
                    break;

                default:
                    banner = "No se pudo enviar el mensaje. Inténtalo más tarde o abre una incidencia en GitHub.";
                    state = SendState.Error;
                    break;
            }
        }
        catch (Exception)
        {
            banner = "No se pudo enviar el mensaje. Inténtalo más tarde.";
            state = SendState.Error;
        }
    }

    private void Reset()
    {
        model.Name = model.Email = model.Subject = model.Body = string.Empty;
        fieldErrors.Clear();
        banner = null;
        state = SendState.Idle;
    }
}
