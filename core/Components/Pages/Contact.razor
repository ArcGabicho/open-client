@page "/contact"

<PageTitle>Open Client | Contacto</PageTitle>

<HeadContent>
    <meta name="description" content="Ponte en contacto con el equipo de OpenClient para consultas comerciales, cotizaciones o alianzas." />
    <meta name="keywords" content="contacto, ventas, consultas, OpenClient, escribir" />

    <meta property="og:title" content="Open Client | Ponte en Contacto" />
    <meta property="og:description" content="Envíanos un mensaje y nos pondremos en contacto contigo a la brevedad." />
    <meta property="og:type" content="website" />
</HeadContent>

<div class="contact">

    <section class="contact-hero">
        <span class="eyebrow"><span class="eyebrow-dot"></span> Contacto</span>
        <h1 class="contact-title">Contáctanos</h1>
        <p class="contact-lead">
            ¿Tienes preguntas sobre Open Client, su despliegue o el proyecto? Escríbenos con el
            formulario o abre una incidencia en el repositorio.
        </p>
    </section>

    <section class="contact-body">
        <form class="contact-form" aria-label="Formulario de contacto">
            <div class="field-row">
                <div class="field">
                    <label for="c-name">Nombre</label>
                    <input id="c-name" name="name" type="text" autocomplete="name" placeholder="Tu nombre" required />
                </div>
                <div class="field">
                    <label for="c-email">Correo</label>
                    <input id="c-email" name="email" type="email" autocomplete="email" placeholder="tucorreo@ejemplo.com" required />
                </div>
            </div>

            <div class="field">
                <label for="c-subject">Asunto</label>
                <input id="c-subject" name="subject" type="text" placeholder="¿En qué te podemos ayudar?" required />
            </div>

            <div class="field">
                <label for="c-message">Mensaje</label>
                <textarea id="c-message" name="message" rows="6" placeholder="Cuéntanos los detalles…" required></textarea>
            </div>

            <button type="submit" class="btn btn-primary contact-submit">Enviar mensaje</button>
            <p class="contact-hint">
                También puedes escribirnos abriendo una incidencia en
                <a href="https://github.com/ArcGabicho/open-client/issues" target="_blank" rel="noopener noreferrer">GitHub</a>.
            </p>
        </form>

        <aside class="contact-aside">
            <h2>Otras vías</h2>
            <ul class="contact-channels">
                <li>
                    <span class="channel-icon">
                        <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                            <path fill-rule="evenodd" clip-rule="evenodd" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.4 7.4 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
                        </svg>
                    </span>
                    <div>
                        <strong>Repositorio</strong>
                        <a href="https://github.com/ArcGabicho/open-client" target="_blank" rel="noopener noreferrer">github.com/ArcGabicho/open-client</a>
                    </div>
                </li>
                <li>
                    <span class="channel-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                            <circle cx="12" cy="12" r="9" />
                            <path d="M12 8v5M12 16h.01" />
                        </svg>
                    </span>
                    <div>
                        <strong>Incidencias</strong>
                        <a href="https://github.com/ArcGabicho/open-client/issues" target="_blank" rel="noopener noreferrer">Reportar un problema o sugerencia</a>
                    </div>
                </li>
                <li>
                    <span class="channel-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                            <circle cx="12" cy="12" r="9" />
                            <path d="M3.5 9h17M3.5 15h17M12 3a13 13 0 0 0 0 18M12 3a13 13 0 0 1 0 18" />
                        </svg>
                    </span>
                    <div>
                        <strong>Demo en vivo</strong>
                        <a href="http://openclient.azure.app" target="_blank" rel="noopener noreferrer">openclient.azure.app</a>
                    </div>
                </li>
            </ul>
        </aside>
    </section>

</div>
