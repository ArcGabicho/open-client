@inherits LayoutComponentBase

<div class="dashboard-shell">

    <input type="checkbox" id="dash-nav-toggle" class="dash-nav-toggle" aria-hidden="true" tabindex="-1" />

    <header class="dash-topbar">

        <div class="dash-topbar-left">
            <a href="/dashboard" class="dash-brand">
                <span class="dash-brand-mark" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="9" />
                        <path d="M12 3a13 13 0 0 0 0 18M12 3a13 13 0 0 1 0 18M3.5 9h17M3.5 15h17" />
                    </svg>
                </span>
                <span class="dash-brand-name">OPEN&nbsp;CLIENT</span>
            </a>

            <label for="dash-nav-toggle" class="dash-burger" aria-label="Abrir menú de navegación">
                <span></span><span></span><span></span>
            </label>

            <nav class="dash-nav" aria-label="Navegación principal">
                <NavLink class="dash-nav-item" href="/dashboard/clients">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M16 19c0-2.2-1.8-4-4-4s-4 1.8-4 4M12 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z" />
                        <path d="M20 19c0-1.6-1-3-2.5-3.6M17 10.8A3 3 0 0 0 17 5" />
                    </svg>
                    <span>Clientes</span>
                </NavLink>

                <NavLink class="dash-nav-item" href="/dashboard/ai-agent">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M12 3l1.9 4.6L18.5 9l-4.6 1.9L12 15l-1.9-4.1L5.5 9l4.6-1.4L12 3Z" />
                    </svg>
                    <span>Agente IA</span>
                </NavLink>

                <NavLink class="dash-nav-item" href="/dashboard/api">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M9 8l-4 4 4 4M15 8l4 4-4 4" />
                    </svg>
                    <span>API</span>
                </NavLink>

                <NavLink class="dash-nav-item" href="/dashboard/tutorials">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M5 4h11l3 3v13H5zM9 4v6l2-1.4L13 10V4" />
                    </svg>
                    <span>Tutoriales</span>
                </NavLink>

                <NavLink class="dash-nav-item" href="/dashboard/settings">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="3" />
                        <path d="M19.4 13a1.65 1.65 0 0 0 .33 1.82l.05.05a2 2 0 1 1-2.83 2.83l-.05-.05a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.05.05a2 2 0 1 1-2.83-2.83l.05-.05a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09a1.65 1.65 0 0 0 1.51-1 1.65 1.65 0 0 0-.33-1.82l-.05-.05a2 2 0 1 1 2.83-2.83l.05.05a1.65 1.65 0 0 0 1.82.33H10a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.05-.05a2 2 0 1 1 2.83 2.83l-.05.05a1.65 1.65 0 0 0-.33 1.82V10a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1Z" />
                    </svg>
                    <span>Configuración</span>
                </NavLink>
            </nav>
        </div>

        <div class="dash-topbar-right">
            <div class="dash-search">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="11" cy="11" r="7" />
                    <path d="M21 21l-4.3-4.3" />
                </svg>
                <input type="search" placeholder="Buscar…" aria-label="Buscar" />
            </div>

            <button type="button" class="dash-icon-circle" aria-label="Notificaciones">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9M13.7 21a2 2 0 0 1-3.4 0" />
                </svg>
                <span class="dash-badge-dot" aria-hidden="true"></span>
            </button>

            <button type="button" class="dash-profile">
                <span class="dash-avatar" aria-hidden="true">GP</span>
                <span class="dash-profile-name">Gabriel Polack</span>
                <svg class="dash-profile-caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M6 9l6 6 6-6" />
                </svg>
            </button>
        </div>

    </header>

    <label for="dash-nav-toggle" class="dash-scrim" aria-hidden="true"></label>

    <main class="dash-content">
        @Body
    </main>

</div>
