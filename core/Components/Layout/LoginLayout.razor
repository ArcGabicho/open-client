@inherits LayoutComponentBase

<div class="login-split-container">
    <!-- Panel Izquierdo: Formulario Dinámico -->
    <div class="form-panel">
        <div class="form-wrapper">
            @Body
        </div>
    </div>

    <!-- Panel Derecho: Ilustración y Testimonio -->
    <div class="cover-panel">
        <div class="cover-card">
            <div class="cover-header">
                <span class="brand-title">OPEN CLIENT</span>
            </div>

            <div class="testimonial-box">
                <p class="testimonial-text">
                    I used this for my last project and it saved me at least 10 hours of busy work. Seriously a game changer!
                </p>
                <div class="testimonial-author">
                    <span class="author-name">Mohin Uddin</span>
                    <span class="author-role">Lead Graphic Designer</span>
                </div>
            </div>
        </div>
    </div>
</div>