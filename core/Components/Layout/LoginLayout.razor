@inherits LayoutComponentBase

<div class="auth-shell">
    <section class="auth-form-side">
        <a href="/" class="auth-brand">
            <span class="auth-brand-mark" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="9" />
                    <path d="M12 3a13 13 0 0 0 0 18M12 3a13 13 0 0 1 0 18M3.5 9h17M3.5 15h17" />
                </svg>
            </span>
            <span class="auth-brand-name">OPEN&nbsp;CLIENT</span>
        </a>

        <div class="auth-form-center">
            <div class="form-wrapper">
                @Body
            </div>
        </div>

        <p class="auth-legal">© 2026 Open Client · Licencia MIT</p>
    </section>

    <aside class="auth-visual-side" aria-hidden="true">
        <div class="auth-visual-content">
            <span class="auth-visual-brand">
                <span class="auth-visual-brand-mark">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="9" />
                        <path d="M12 3a13 13 0 0 0 0 18M12 3a13 13 0 0 1 0 18M3.5 9h17M3.5 15h17" />
                    </svg>
                </span>
                OPEN&nbsp;CLIENT
            </span>

            <h2 class="auth-visual-headline">
                El sistema de datos comerciales de tus clientes, en tu propia infraestructura.
            </h2>

            <p class="auth-visual-sub">
                Despliega el panel con Docker y conserva el control total sobre la información.
            </p>
        </div>
    </aside>

</div>
