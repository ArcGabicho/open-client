@inherits LayoutComponentBase

<div class="public-shell">

    <input type="checkbox" id="oc-nav-toggle" class="nav-toggle" aria-hidden="true" tabindex="-1" />

    <header class="site-header">
        <div class="site-header-inner">

            <a href="/" class="brand">
                <span class="brand-mark" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="9" />
                        <path d="M12 3a13 13 0 0 0 0 18M12 3a13 13 0 0 1 0 18M3.5 9h17M3.5 15h17" />
                    </svg>
                </span>
                <span class="brand-name">OPEN&nbsp;CLIENT</span>
            </a>

            <label for="oc-nav-toggle" class="nav-burger" aria-label="Abrir menú de navegación">
                <span></span><span></span><span></span>
            </label>

            <nav class="site-nav">
                <NavLink href="/" Match="NavLinkMatch.All" class="nav-item">Inicio</NavLink>
                <NavLink href="/about" class="nav-item">Nosotros</NavLink>
                <NavLink href="/docs" class="nav-item">Documentación</NavLink>
                <NavLink href="/contact" class="nav-item">Contacto</NavLink>
                <a href="/log-in" class="nav-item nav-item-inline-login">Iniciar sesión</a>
            </nav>

            <div class="site-actions">
                <a href="https://github.com/ArcGabicho/open-client" target="_blank" rel="noopener noreferrer"
                   class="ghost-icon" aria-label="Repositorio en GitHub">
                    <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                        <path fill-rule="evenodd" clip-rule="evenodd" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.4 7.4 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
                    </svg>
                </a>
                <a href="/log-in" class="cta-pill">Iniciar sesión</a>
            </div>

        </div>
    </header>

    <main class="site-main">
        @Body
    </main>

    <footer class="site-footer">
        <div class="site-footer-inner">

            <div class="footer-top">
                <div class="footer-brand-col">
                    <a href="/" class="footer-brand">
                        <span class="footer-brand-mark" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="9" />
                                <path d="M12 3a13 13 0 0 0 0 18M12 3a13 13 0 0 1 0 18M3.5 9h17M3.5 15h17" />
                            </svg>
                        </span>
                        <span>OPEN&nbsp;CLIENT</span>
                    </a>
                    <p class="footer-tagline">
                        Panel comercial y sistema de datos de clientes para desplegar en tu
                        propia infraestructura.
                    </p>
                    <a href="https://github.com/ArcGabicho/open-client" target="_blank" rel="noopener noreferrer"
                       class="footer-ghost-icon" aria-label="Repositorio en GitHub">
                        <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                            <path fill-rule="evenodd" clip-rule="evenodd" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.4 7.4 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
                        </svg>
                    </a>
                </div>

                <nav class="footer-links" aria-label="Enlaces del pie de página">
                    <div class="footer-col">
                        <span class="footer-col-title">Producto</span>
                        <a href="/">Inicio</a>
                        <a href="/docs">Documentación</a>
                        <a href="/log-in">Iniciar sesión</a>
                    </div>
                    <div class="footer-col">
                        <span class="footer-col-title">Proyecto</span>
                        <a href="/about">Nosotros</a>
                        <a href="/contact">Contacto</a>
                        <a href="https://github.com/ArcGabicho/open-client" target="_blank" rel="noopener noreferrer">
                            GitHub&nbsp;↗
                        </a>
                    </div>
                </nav>
            </div>

            <div class="footer-bottom">
                <span class="footer-legal">© 2026 Open Client · Licencia MIT</span>
                <span class="footer-built">Construido con .NET&nbsp;10 · Blazor · Docker</span>
            </div>

        </div>
    </footer>

</div>